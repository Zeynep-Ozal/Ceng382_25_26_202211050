@page
@model RazorPage.Pages.LoginModel
@using RazorPage.Models
@{
    ViewData["Title"] = "User Management";
}

<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f4f6f8;
        margin: 0;
        padding: 2rem;
    }

    h2 {
        color: #333;
        margin-top: 2rem;
    }

    form {
        background-color: white;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        max-width: 500px;
    }

    form div {
        margin-bottom: 1rem;
    }

    label {
        display: block;
        margin-bottom: 0.5rem;
        color: #555;
        font-weight: bold;
    }

    input[type="text"],
    input[type="password"] {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    input[type="checkbox"] {
        transform: scale(1.2);
        margin-right: 0.5rem;
    }

    button {
        padding: 0.5rem 1rem;
        background-color: #007bff;
        border: none;
        color: white;
        border-radius: 4px;
        cursor: pointer;
    }

    button:hover {
        background-color: #0056b3;
    }

    ul {
        list-style: none;
        padding: 0;
        margin-top: 1rem;
        max-width: 500px;
    }

    ul li {
        background-color: white;
        padding: 1rem;
        border-radius: 6px;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
        margin-bottom: 0.5rem;
    }
</style>


<form method="post">
    <div>
        <label>Username:</label>
<input asp-for="Username" placeholder="Username" />

    </div>
    <div>
        <label>Password:</label>
        <input asp-for="Password" type="password" placeholder="Password" />
    </div>
    <button type="submit">Login</button>
</form>

<hr />

